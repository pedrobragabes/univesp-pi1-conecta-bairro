<%- include('partials/header') %>
<section class="hero">
  <div class="hero-copy reveal">
    <p class="eyebrow">Participação que vira ação</p>
    <h1>O bairro fala.<br><em>A comunidade acompanha.</em></h1>
    <p class="hero-text">Registre necessidades do cotidiano, acompanhe o atendimento e ajude a priorizar o que melhora a vida de todos.</p>
    <div class="hero-actions">
      <a class="button" href="/solicitacoes/nova">Registrar solicitação</a>
      <a class="text-link" href="/solicitacoes">Ver mural completo →</a>
    </div>
  </div>
  <aside class="hero-note reveal delay-1" aria-label="Resumo do projeto">
    <span class="pin" aria-hidden="true"></span>
    <p class="note-label">COMO FUNCIONA</p>
    <ol>
      <li><span>01</span> Descreva a necessidade</li>
      <li><span>02</span> Informe o local</li>
      <li><span>03</span> Acompanhe o andamento</li>
    </ol>
  </aside>
</section>

<section class="dashboard-section" aria-labelledby="visao-geral">
  <div class="section-heading">
    <div><p class="eyebrow">Visão geral</p><h2 id="visao-geral">Pulso da comunidade</h2></div>
    <p>Indicadores atualizados a partir dos registros no banco de dados.</p>
  </div>
  <div class="metrics-grid">
    <article class="metric-card metric-total"><span>Total de registros</span><strong><%= indicators.total %></strong><small>solicitações cadastradas</small></article>
    <article class="metric-card"><span>Abertas</span><strong><%= indicators.abertas %></strong><div class="metric-line"><i style="width:<%= indicators.total ? (indicators.abertas / indicators.total) * 100 : 0 %>%"></i></div></article>
    <article class="metric-card"><span>Em andamento</span><strong><%= indicators.andamento %></strong><div class="metric-line orange"><i style="width:<%= indicators.total ? (indicators.andamento / indicators.total) * 100 : 0 %>%"></i></div></article>
    <article class="metric-card"><span>Concluídas</span><strong><%= indicators.concluidas %></strong><div class="metric-line green"><i style="width:<%= indicators.total ? (indicators.concluidas / indicators.total) * 100 : 0 %>%"></i></div></article>
  </div>
</section>

<section class="content-grid">
  <div>
    <div class="section-heading compact"><div><p class="eyebrow">Movimento recente</p><h2>Últimas solicitações</h2></div><a class="text-link" href="/solicitacoes">Ver todas →</a></div>
    <div class="request-list">
      <% if (!latest.length) { %><div class="empty-state"><h3>Nenhuma solicitação ainda</h3><p>O mural está pronto para receber o primeiro registro.</p></div><% } %>
      <% latest.forEach((item, index) => { %>
        <a class="request-row reveal" style="--delay:<%= index * 70 %>ms" href="/solicitacoes/<%= item.id %>">
          <span class="category-icon" aria-hidden="true"><%= item.categoria.slice(0, 2).toUpperCase() %></span>
          <span class="request-main"><strong><%= item.titulo %></strong><small><%= item.localizacao %> · <%= formatDate(item.created_at) %></small></span>
          <span class="status status-<%= statusClass(item.status) %>"><%= item.status %></span>
          <span aria-hidden="true">↗</span>
        </a>
      <% }) %>
    </div>
  </div>
  <aside class="category-board">
    <p class="eyebrow">Por categoria</p>
    <h2>Onde estão as demandas</h2>
    <ul>
      <% indicators.categories.forEach((category) => { %>
        <li><span><%= category.categoria %></span><strong><%= category.total %></strong></li>
      <% }) %>
    </ul>
  </aside>
</section>
<%- include('partials/footer') %>

