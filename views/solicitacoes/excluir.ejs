<%- include('../partials/header') %>
<section class="form-layout">
  <div class="form-aside">
    <p class="eyebrow">Revise antes de continuar</p>
    <h1>Excluir solicitação?</h1>
    <p>Esta ação apaga o registro definitivamente. Cancelar preserva a solicitação.</p>
  </div>
  <div class="form-panel">
    <h2><%= item.titulo %></h2>
    <p><%= item.localizacao %></p>
    <p>Situação atual: <strong><%= item.status %></strong></p>
    <form method="post" action="/solicitacoes/<%= item.id %>/excluir">
      <div class="form-actions">
        <a class="text-link" href="/solicitacoes/<%= item.id %>">Cancelar</a>
        <button class="button button-dark" type="submit" name="confirmar" value="sim">Confirmar exclusão</button>
      </div>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
